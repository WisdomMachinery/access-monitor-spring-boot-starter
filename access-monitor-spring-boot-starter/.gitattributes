# 统一换行符，避免 Windows 检出的 CRLF 与 CI(Linux) 冲突
* text=auto eol=lf

# Windows 批处理必须使用 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Maven Wrapper 的 shell 脚本必须保持 LF，否则 Linux 下无法执行
mvnw text eol=lf
mvnw.cmd text eol=crlf

# 二进制文件不做换行转换
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
